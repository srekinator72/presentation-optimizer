<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>2b7f7fd2-0586-44ad-b024-9f31e498f500</Id>
  <Version>2.0.0.0</Version>
  <ProviderName>Варя Васильева</ProviderName>
  <DefaultLocale>ru-RU</DefaultLocale>
  <DisplayName DefaultValue="Presentation Optimizer (бета)"/>
  <Description DefaultValue="Показывает, что утяжеляет презентацию: лишние пиксели в картинках, 4K-видео, шрифты, данные диаграмм. И подсказывает, как это исправить."/>
  <IconUrl DefaultValue="https://srekinator72.github.io/presentation-optimizer/app-beta/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://srekinator72.github.io/presentation-optimizer/app-beta/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://github.com/srekinator72/presentation-optimizer"/>
  <AppDomains>
    <AppDomain>https://srekinator72.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://srekinator72.github.io/presentation-optimizer/app-beta/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Presentation">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="PresOptimizerGroup">
                <Label resid="CommandsGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="PresOptimizerButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>PresOptimizerPane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://srekinator72.github.io/presentation-optimizer/app-beta/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://srekinator72.github.io/presentation-optimizer/app-beta/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://srekinator72.github.io/presentation-optimizer/app-beta/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://github.com/srekinator72/presentation-optimizer"/>
        <bt:Url id="Commands.Url" DefaultValue="https://srekinator72.github.io/presentation-optimizer/app-beta/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://srekinator72.github.io/presentation-optimizer/app-beta/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Presentation Optimizer (бета) установлен"/>
        <bt:String id="CommandsGroup.Label" DefaultValue="Вес презентации"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Анализ веса"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Кнопка «Анализ веса» — на вкладке «Главная», справа."/>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Показать, что утяжеляет презентацию и как это исправить"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
